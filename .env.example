NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Server-only. Create a dedicated Supabase secret key for the analytics route.
SUPABASE_SECRET_KEY=

# Server-only. Keep false unless a deliberate non-production analytics test is required.
ANALYTICS_ALLOW_NON_PRODUCTION=false

# Server-only. Leave false when a non-production environment points at production data.
ALLOW_NON_PRODUCTION_ADMIN_WRITES=false
